{
	"name": "seedcord-ver",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "seedcord dev",
		"build": "seedcord build",
		"start": "node --enable-source-maps dist/index.mjs",
		"codegen": "seedcord codegen",
		"make": "seedcord make",
		"ask": "seedcord ask",
		"commands": "seedcord commands",
		"commands:deploy": "seedcord commands deploy",
		"tc": "tsc --noEmit",
		"lint": "eslint \"src/**/*.ts\" --cache",
		"lint:fix": "eslint \"src/**/*.ts\" --fix --cache",
		"fmt": "prettier --write \"src/**/*.{ts,json,md}\" --cache",
		"fmt:check": "prettier --check \"src/**/*.{ts,json,md}\" --cache",
		"check": "pnpm run tc && pnpm run lint && pnpm run fmt:check"
	},
	"dependencies": {
		"@discordjs/builders": "^1.15.0",
		"@seedcord/gateway": "^0.10.0",
		"discord-api-types": "^0.38.58",
		"discord.js": "^14.28.1",
		"envapt": "^9.2.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@content-collections/core": "^0.15.3",
		"@content-collections/vite": "^0.3.1",
		"@seedcord/eslint-config": "^3.0.1",
		"@seedcord/tsconfig": "^3.0.0",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.10",
		"seedcord": "^0.23.2",
		"typescript": "~6.0.3",
		"vite": "^8.3.6",
		"zod": "^4.6.7"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^12",
			"onFail": "warn"
		}
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	}
}
