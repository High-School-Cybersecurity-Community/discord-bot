# The bot's login token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Webhook urls the built-in error reporters post to. Leave a key unset to disable its reporter.
HANDLED_EXCEPTION_WEBHOOK_URL=
UNKNOWN_EXCEPTION_WEBHOOK_URL=

# Test server ids while developing, comma separated. Unset deploys commands globally.
# TESTING_GUILD_IDS=111,222

# Support system
MOD_ROLE=
SUPPORT_SERVER_CHANNEL=
SUPPORT_TICKET_CATEGORY=

# Build version shown in the bot's status. Falls back to the package.json version.
PUBLIC_BUILD_VERSION=
